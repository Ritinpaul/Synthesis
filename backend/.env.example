# Copy this file to .env and fill in real values — never commit .env

# Supabase PostgreSQL connection string (psycopg3 driver)
SYNTHESIS_DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

# JWT signing secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SYNTHESIS_JWT_SECRET=replace-with-a-32-char-random-secret

# Optional overrides
# SYNTHESIS_ENVIRONMENT=production
# SYNTHESIS_TOKEN_EXPIRY_MINUTES=43200
